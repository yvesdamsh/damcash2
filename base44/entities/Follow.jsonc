{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "ID of the user who is following"
    },
    "target_id": {
      "type": "string",
      "description": "ID of the user or team being followed"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "team"
      ],
      "default": "user",
      "description": "Type of entity being followed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "follower_id",
    "target_id"
  ]
}